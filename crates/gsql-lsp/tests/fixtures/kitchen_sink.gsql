# Schema
DROP ALL
CREATE VERTEX Person (PRIMARY_ID id STRING, name STRING, age INT DEFAULT 0, emails SET<STRING>, props MAP<STRING, INT>) WITH primary_id_as_attribute="true"
CREATE VERTEX Account (id STRING PRIMARY KEY, balance DOUBLE)
CREATE VERTEX Employee (fname STRING, lname STRING, title STRING COMPRESS, PRIMARY KEY (fname, lname))
CREATE UNDIRECTED EDGE Friendship (FROM Person, TO Person, connect_day DATETIME)
CREATE DIRECTED EDGE Follows (FROM Person, TO Person) WITH REVERSE_EDGE="followed_by"
CREATE DIRECTED EDGE Purchased (FROM Person, TO Account, DISCRIMINATOR(ts DATETIME), amount DOUBLE)
CREATE DIRECTED EDGE Links (FROM Person, TO Account | FROM Employee, TO Account, w FLOAT)
CREATE UNDIRECTED EDGE Any2Any (FROM *, TO *)
CREATE GRAPH Social (Person, Friendship, Follows)
CREATE GRAPH Everything (*)
TYPEDEF TUPLE <f1 INT (1), f2 UINT, f3 STRING (10), f4 DOUBLE> myTuple
USE GRAPH Social

CREATE OR REPLACE QUERY hello(VERTEX<Person> p, INT k = 3, SET<STRING> names, FLOAT damping = 0.85) FOR GRAPH Social RETURNS (INT) SYNTAX v2 {
  TYPEDEF TUPLE <INT score, VERTEX v> Rec;
  SumAccum<INT> @@total = 0;
  SumAccum<INT> @count;
  MapAccum<STRING, SumAccum<INT>> @@counts;
  MapAccum<INT, MapAccum<STRING, SetAccum<VERTEX<Person>>>> @@nested;
  HeapAccum<Rec>(10, score DESC) @@heap;
  GroupByAccum<INT a, STRING b, SumAccum<INT> c> @@group;
  ArrayAccum<SumAccum<INT>> @@arr[5][10];
  ListAccum<STRING> @@l = ["a", "b"];
  OrAccum @visited;
  static SetAccum<INT> @@seen;
  INT x = 5, y;
  DATETIME d = to_datetime("2020-01-01");
  Rec r = Rec(1, p);
  FILE f1 ("/tmp/out.csv");
  EXCEPTION myEx (40001);

  Start = {p};
  All (Person) = {Person.*};
  Any = {ANY};
  Result = SELECT t FROM Start:s -(Friendship:e)- Person:t
           WHERE t.age > 18 AND s != t AND t.name NOT IN names
           ACCUM t.@count += 1, @@total += 1,
                 IF t.age > 30 THEN @@counts += ("old" -> 1) ELSE IF t.age > 20 THEN @@counts += ("mid" -> 1) ELSE @@counts += ("young" -> 1) END
           POST-ACCUM t.@count = t.@count * 2, @@heap += Rec(t.@count, t)
           HAVING t.@count > 1
           ORDER BY t.@count DESC, t.name ASC
           LIMIT 10;
  R2 = SELECT t FROM Person:s -(Friendship>*1..3)- Person:t WHERE s.@visited' == FALSE;
  R3 = SELECT t FROM Start:s -((Friendship|Follows):e)-> (Person|Account):t SAMPLE 10 EDGE WHEN s.outdegree() > 10;
  R4 = SELECT t FROM (s:Person) -[e:Friendship]-> (t:Person);
  SELECT s.name AS n, COUNT(t) AS c INTO T FROM Person:s -(Friendship)- Person:t GROUP BY s.name;
  WHILE Start.size() > 0 LIMIT 10 DO
    Start = SELECT t FROM Start:s -(Friendship)- :t WHERE t.@visited == FALSE ACCUM t.@visited = TRUE;
    IF x > 3 THEN BREAK; END;
  END;
  FOREACH i IN RANGE[0, 10].STEP(2) DO
    x = x + i;
  END;
  FOREACH (k, v) IN @@counts DO PRINT k, v; END;
  CASE WHEN x > 1 THEN PRINT "big"; ELSE PRINT "small"; END;
  x = CASE x WHEN 1 THEN 10 WHEN 2 THEN 20 ELSE 0 END;
  d = datetime_add(d, INTERVAL 1 DAY);
  @@arr[1][2] += 5;
  @@group += (1, "a" -> 2);
  PRINT Result[Result.name AS n, Result.@count], @@total AS total;
  PRINT @@heap TO_CSV f1;
  f1.println(x, y);
  LOG(TRUE, "x is", x);
  INSERT INTO Person VALUES ("id1", "name", 20);
  INSERT INTO Friendship (FROM, TO, connect_day) VALUES (p Person, p Person, now());
  DELETE s FROM Start:s WHERE s.age > 100;
  UPDATE s FROM Start:s SET s.age = s.age + 1 WHERE s.name LIKE "%x%";
  TRY
    RAISE myEx("oops " + to_string(x));
  EXCEPTION
    WHEN myEx THEN PRINT "caught";
  END;
  S3 = Start UNION Result MINUS R2 INTERSECT R3;
  STRING s = trim(LEADING " " FROM "  x");
  BOOL bb = x BETWEEN 1 AND 10 AND y IS NOT NULL;
  RETURN @@total;
}
INSTALL QUERY hello
INSTALL QUERY -OPTIMIZE hello, hello2
RUN QUERY hello(("Tom", "Person"), 3, ["a", "b"], 0.5)
SHOW QUERY hello
LS

CREATE LOADING JOB load_social FOR GRAPH Social {
  DEFINE FILENAME file1 = "/data/persons.csv";
  DEFINE FILENAME file2;
  DEFINE HEADER h1 = "id", "name";
  DEFINE INPUT_LINE_FILTER filt = $1 == "x";
  LOAD file1 TO VERTEX Person VALUES ($0, $1, _, _, _) USING SEPARATOR=",", HEADER="true", EOL="\n";
  LOAD file2 TO EDGE Friendship VALUES ($0, $1, $2) WHERE to_int($2) > 0 AND $3 IS NUMERIC;
  LOAD file1 TO VERTEX Person VALUES ($"id", gsql_concat($1, "_", $2), REDUCE(add($3))) USING header="true";
  LOAD file1 TO TEMP_TABLE t1 (c1, c2) VALUES ($0, flatten($1, "|", 1));
  LOAD TEMP_TABLE t1 TO VERTEX Person VALUES ($"c1", $"c2", _, _, _);
  LOAD file2 TO EDGE Any2Any VALUES ($0 Person, $1 $2);
  DELETE VERTEX Person (PRIMARY_ID $0) FROM file1;
  DELETE EDGE Friendship (FROM $0, TO $1) FROM file2 WHERE $2 == "old";
}
RUN LOADING JOB -noprint load_social USING file1="/tmp/a.csv", EOF="true"

CREATE SCHEMA_CHANGE JOB j1 FOR GRAPH Social {
  ADD VERTEX Cat (PRIMARY_ID name STRING, age INT);
  ADD UNDIRECTED EDGE Owns (FROM Person, TO Cat);
  ALTER VERTEX Person ADD ATTRIBUTE (email STRING DEFAULT "none", score FLOAT);
  ALTER VERTEX Person DROP ATTRIBUTE (email);
  ALTER VERTEX Person ADD INDEX name_idx ON (name);
  DROP VERTEX Dog;
  DROP EDGE Has, Had;
}
RUN SCHEMA_CHANGE JOB j1
CREATE GLOBAL SCHEMA_CHANGE JOB g1 {
  ADD VERTEX Dog (PRIMARY_ID id STRING);
  ALTER GRAPH Social ADD VERTEX Dog, EDGE Owns;
}
RUN GLOBAL SCHEMA_CHANGE JOB g1
GRANT ROLE analyst ON GRAPH Social TO alice, bob
REVOKE ROLE analyst ON GRAPH Social FROM alice
GRANT READ_SCHEMA, CREATE ON GRAPH Social TO analyst
CREATE ROLE analyst
DROP QUERY hello
DROP ALL
CREATE OPENCYPHER QUERY oc(STRING n) FOR GRAPH Social {
  MATCH (p:Person {name: $n})-[:Friendship]-(f) RETURN f
}
INTERPRET QUERY () FOR GRAPH Social { PRINT "hi"; }
INTERPRET QUERY hello("x")
EXPORT GRAPH ALL TO "/tmp/export"
SET exit_on_error = "FALSE"
BEGIN
CREATE VERTEX X (PRIMARY_ID id INT)
END
@/tmp/other.gsql
