USE GRAPH Social

CREATE LOADING JOB load_social FOR GRAPH Social {
    DEFINE FILENAME people = "/data/social/people.csv";
    DEFINE FILENAME posts = "/data/social/posts.csv";
    DEFINE FILENAME friendships;
    DEFINE FILENAME likes;
    DEFINE HEADER post_header = "id", "author", "content", "created", "tags";

    // id,name,age,gender,joined,interests (interests separated by |)
    LOAD people TO VERTEX Person VALUES ($0, $1, $2, $3, $4, SPLIT($5, "|"))
      USING SEPARATOR=",", HEADER="true", EOL="\n";

    LOAD posts
      TO VERTEX Post VALUES ($"id", $"content", $"created", _),
      TO EDGE Wrote VALUES ($"author", $"id")
      USING USER_DEFINED_HEADER=post_header, SEPARATOR=",", QUOTE="double";

    LOAD posts TO TEMP_TABLE post_tags (post, tag) VALUES ($0, flatten($4, "|", 1))
      USING SEPARATOR=",", HEADER="true";
    LOAD TEMP_TABLE post_tags
      TO VERTEX Tag VALUES ($"tag", _),
      TO EDGE Tagged VALUES ($"post", $"tag");

    // Skip self-friendships and malformed strengths.
    LOAD friendships TO EDGE Friendship VALUES ($0, $1, $2, $3)
      WHERE $0 != $1 AND $3 IS NUMERIC
      USING SEPARATOR=",", HEADER="true";

    LOAD likes TO EDGE Likes VALUES ($0, $1, gsql_ts_to_epoch_seconds($2))
      USING SEPARATOR="\t", HEADER="false";
}

RUN LOADING JOB load_social USING friendships="/data/social/friendships.csv", likes="/data/social/likes.tsv"
