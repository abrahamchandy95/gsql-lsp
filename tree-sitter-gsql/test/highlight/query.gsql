CREATE QUERY pr(VERTEX<Person> p, FLOAT damping = 0.85) FOR GRAPH Social {
// <- keyword
//     ^ keyword.function
//           ^ function
//              ^ type.builtin
//                     ^ type
//                             ^ variable.parameter
//                                ^ type.builtin
//                                                ^ number.float
//                                                                ^ module
  MaxAccum<FLOAT> @@max_diff = 9999;
//^ type.builtin
//         ^ type.builtin
//                ^ variable.member
//                             ^ number
  Start = {Person.*};
//^ variable
//         ^ type
//                ^ character.special
  WHILE @@max_diff > 0.001 LIMIT 20 DO
//^ keyword.repeat
//                         ^ keyword.repeat
//                                  ^ keyword.repeat
    Start = SELECT s FROM Start:s -(Follows>:e)- Person:t
//          ^ keyword
//                   ^ keyword
//                                  ^ type
//                                           ^ variable
//                                               ^ type
            ACCUM t.@score += s.@score / s.outdegree("Follows")
//          ^ keyword
//                  ^ variable.member
//                                         ^ function.method.call
//                                                   ^ string
            POST-ACCUM @@max_diff += abs(s.@score - s.@score');
//          ^ keyword
//                                   ^ function.builtin
//                                                          ^ operator
  END;
//^ keyword.repeat
  IF @@max_diff < 0 THEN PRINT "x"; ELSE PRINT "y"; END;
//^ keyword.conditional
//                  ^ keyword.conditional
//                       ^ keyword
//                                  ^ keyword.conditional
//                                                  ^ keyword.conditional
  x = GSQL_INT_MAX * 2;
//    ^ constant.builtin
//                 ^ operator
  // a comment
//^ comment
}
CREATE QUERY near(FILE out) SYNTAX v3 {
//                ^ type.builtin
  CREATE DIRECTED VIRTUAL EDGE Near (FROM Person, TO Person);
//                ^ keyword.modifier
//                             ^ type.definition
  SELECT m INTO T FROM (n:Person {name: "Adam"})-[:_*1..2]-(m);
//                                ^ variable.member
//                                                 ^ character.special
  PRINT ~@@bits, range(1, 3) WITH VECTOR;
//      ^ operator
//               ^ function.builtin
//                                ^ keyword
}
